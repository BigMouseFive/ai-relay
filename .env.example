# 复制为 .env 并设置权限：chmod 600 .env
# 不要将真实 key 提交到仓库。

# OpenAI-compatible API target（internal-openai-terra）所需 key：
AI_RELAY_INTERNAL_OPENAI_API_KEY='replace-with-rotated-key'

# 可选：ACP/Cursor Agent CLI 可通过此 key 绕过 macOS Keychain 登录态。
# 仅在对应 ACP target 配置 api_key_env: CURSOR_API_KEY 时使用。
# CURSOR_API_KEY='replace-with-cursor-api-key'
